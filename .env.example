# Copy to .env and set real values. Single shared cookie/credentials domain
# across every service: kazoo apps, ecallmgr, kazoo-init (sup), freeswitch.

# erlang distribution + kazoo app cookie (config.ini [bigcouch]/[kazoo_apps]/
# [ecallmgr] + ~/.erlang.cookie + FS kazoo.conf.xml). Change me!
ERLANG_COOKIE=change_me_cookie

# RabbitMQ (kazoo apps uri, freeswitch KZ_AMQP_*, kamailio MY_AMQP_URL/rabbit host)
RABBITMQ_DEFAULT_USER=kazoo
RABBIT_USER=kazoo
RABBITMQ_DEFAULT_PASS=change_me_rabbit
RABBIT_PASS=change_me_rabbit

# CouchDB admin (COUCHDB_* consumed by the image; COUCH_* by kazoo config.ini)
COUCHDB_USER=admin
COUCHDB_PASSWORD=change_me_couch
COUCHDB_SECRET=change_me_couch_secret

# PostgreSQL (kamailio subscriber/dispatcher storage)
POSTGRES_USER=kamailio
POSTGRES_PASSWORD=change_me_pg

# Master account created by kazoo-init
MASTER_ACCOUNT_NAME=Master Account
MASTER_REALM=sip.example.local
MASTER_USER=administrator
MASTER_PASS=change_me_master

# Monster-UI branding + crossbar API base
WHITELABEL_NAME=Kazoo
APPLICATION_TITLE=Kazoo Classic

# Kamailio advertised public IP (SIP registrar/edge). Leave empty on LAN/kind.
KAMAILIO_PUBLIC_IP=